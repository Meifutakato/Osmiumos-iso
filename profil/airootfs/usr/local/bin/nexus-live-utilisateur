#!/usr/bin/env bash
# NexusOS — crée l'utilisateur « nexus » de la session d'essai (à chaque démarrage de la clé : tout est en mémoire)
id nexus >/dev/null 2>&1 && exit 0
useradd -m -G wheel,video,audio,input,network,storage,gamemode -s /bin/bash -c "NexusOS" nexus 2>/dev/null \
  || useradd -m -G wheel,video,audio,input -s /bin/bash -c "NexusOS" nexus
passwd -d nexus >/dev/null
sudo -u nexus xdg-user-dirs-update 2>/dev/null || true
